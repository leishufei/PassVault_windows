/* PassVault application-specific styles (Figma redesign). */

/* ---------- Workspace shell ---------- */

QMainWindow, #WorkspaceRoot {
    background-color: var(--bg-primary);
}

#WorkspaceContainer {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border);
    border-radius: var(--radius-shell);
}

#WorkspaceContainer > QWidget {
    background: transparent;
}

/* ---------- Sidebar ---------- */

#Sidebar {
    background-color: var(--bg-sidebar);
    border-right: 1px solid var(--border-soft);
    border-top-left-radius: var(--radius-shell);
    border-bottom-left-radius: var(--radius-shell);
}
#Sidebar QLabel { background: transparent; }

#SidebarBrand { background: transparent; }
#Sidebar #SidebarBrandBadge {
    background-color: var(--accent);
    border-radius: var(--radius-lg);
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
}
#SidebarBrandName {
    color: var(--text-primary);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.51px;
}
#SidebarBrandTagline {
    color: var(--text-tertiary);
    font-size: 11px;
    letter-spacing: 0.3px;
}

#NewPasswordButton {
    background-color: var(--accent);
    color: var(--accent-fg);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
    padding: 0 14px;
    min-height: 40px;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 20px;
}
#NewPasswordButton:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
}
#NewPasswordButton:pressed {
    background-color: var(--accent-pressed);
    border-color: var(--accent-pressed);
}

#SidebarSectionList, #SidebarCategoryList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}
#SidebarSectionList::item, #SidebarCategoryList::item {
    padding: 0 12px;
    min-height: 36px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    margin: 0;
}
#SidebarSectionList::item:hover, #SidebarCategoryList::item:hover {
    background-color: var(--primary-hover-surface);
    color: var(--text-primary);
}
#SidebarSectionList::item:selected, #SidebarCategoryList::item:selected {
    background-color: var(--primary-tint);
    color: var(--primary-text-on-tint);
    font-weight: 600;
}
#SidebarCategoryList::item {
    min-height: 32px;
}

#SidebarDivider {
    background-color: var(--border-sidebar-2);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

#SidebarSectionHeader {
    color: var(--placeholder-4);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    padding: 0 4px;
}

#SidebarAddCategoryButton {
    color: var(--muted-5);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    padding: 4px;
}
#SidebarAddCategoryButton:hover {
    background: var(--border-nav-hover);
    color: var(--accent);
}

#SidebarFooter {
    background: transparent;
    border-top: 1px solid var(--border-sidebar-2);
}

#SyncStatusRow {
    background: transparent;
    color: var(--muted-13);
    font-size: 12px;
}
#SyncStatusDot {
    background-color: var(--success);
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
#SyncStatusDot[state="idle"]  { background-color: var(--success); }
#SyncStatusDot[state="busy"]  { background-color: var(--warn); }
#SyncStatusDot[state="error"] { background-color: var(--danger); }

#SidebarSettingsButton {
    background: transparent;
    color: var(--muted-8);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0 12px;
    min-height: 36px;
    text-align: left;
    font-weight: 400;
    font-size: 13px;
}
#SidebarSettingsButton:hover {
    background: var(--primary-hover-surface);
    color: var(--text-primary);
}

/* ---------- Password list column ---------- */

#PasswordListColumn {
    background-color: var(--bg-canvas);
    border-right: 1px solid var(--border-section-2);
}

#VaultWorkspaceHeader {
    background-color: var(--bg-canvas);
    border-top-right-radius: var(--radius-shell);
    min-height: 68px;
    max-height: 68px;
}

#VaultWorkspaceHeaderControls { background: transparent; }
#VaultWorkspaceHeaderDivider {
    background-color: var(--border-section);
    border: none;
}

#SearchBarContainer {
    background-color: var(--bg-search);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-panel);
}
#SearchBarContainer[focused="true"] {
    border-color: var(--focus-ring);
    background-color: var(--bg-elevated);
}
#SearchBar {
    padding: 0 4px 0 10px;
    background: transparent;
    border: none;
    color: var(--text-primary);
}
#SearchBar::placeholder {
    color: var(--placeholder);
}
#SearchShortcut {
    min-width: 45px;
    max-width: 45px;
    min-height: 20px;
    max-height: 20px;
    background-color: var(--bg-elevated);
    color: var(--placeholder);
    border-radius: 4px;
    font-family: "DM Mono", "Cascadia Mono", Consolas, monospace;
    font-size: 9px;
}

#HeaderLockButton, #HeaderNavigationButton, #HeaderBackToListButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
    color: var(--primary-icon-lock);
    min-width: 34px;
    min-height: 34px;
}
#HeaderLockButton:hover, #HeaderNavigationButton:hover,
#HeaderBackToListButton:hover {
    background: var(--primary-hover-surface-2);
}

#HeaderSeparator {
    background: var(--border-divider-hair);
    margin: 0 4px;
    border: none;
}

#HeaderMoreButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
    color: var(--muted-9);
    min-width: 34px;
    min-height: 34px;
}
#HeaderMoreButton:hover {
    background: var(--primary-hover-surface-5);
}

#ListTitleRow { background: transparent; }
#ListTitle {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
}
#ListCount {
    color: var(--primary-accent-text);
    font-size: 12px;
    font-weight: 500;
}
#ListSortMenu {
    background: transparent;
    color: var(--hint-5);
    border: none;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 500;
    border-radius: var(--radius-md);
}
#ListSortMenu:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

#PasswordList {
    background: transparent;
    border: none;
    /* QListWidget spacing also contributes 6px to the outer item inset. */
    padding: 6px 22px 20px 22px;
    outline: none;
}
#PasswordList::item {
    padding: 0;
    margin: 0;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-card);
    background: var(--card);
}
#PasswordList::item:hover {
    background-color: var(--card-hover);
    border-color: var(--border-card-hover);
}
#PasswordList::item:selected {
    background-color: var(--card-selected);
    border-color: var(--border-card-selected);
}
#PasswordList::item:focus {
    border: 2px solid var(--focus-ring);
}

#PasswordCard {
    background: transparent;
    border-radius: var(--radius-xl);
}
#PasswordCardIcon {
    border-radius: var(--radius-lg);
    font-size: 13px;
    font-weight: 700;
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}
#PasswordCardIcon[colorIndex="0"] {
    background-color: var(--avatar-0-bg);
    color: var(--avatar-0-fg);
}
#PasswordCardIcon[colorIndex="1"] {
    background-color: var(--avatar-1-bg);
    color: var(--avatar-1-fg);
}
#PasswordCardIcon[colorIndex="2"] {
    background-color: var(--avatar-2-bg);
    color: var(--avatar-2-fg);
}
#PasswordCardIcon[colorIndex="3"] {
    background-color: var(--avatar-3-bg);
    color: var(--avatar-3-fg);
}
#PasswordCardIcon[colorIndex="4"] {
    background-color: var(--avatar-4-bg);
    color: var(--avatar-4-fg);
}
#PasswordCardIcon[colorIndex="5"] {
    background-color: var(--avatar-5-bg);
    color: var(--avatar-5-fg);
}
#PasswordCardTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
}
#PasswordCardMeta {
    color: var(--hint-3);
    font-size: 11px;
}
#PasswordCardTime {
    color: var(--placeholder-2);
    font-size: 10px;
    font-weight: 500;
}
#PasswordCardStar {
    background: transparent;
    border: none;
    padding: 0;
}
#PasswordListEmpty {
    color: var(--text-tertiary);
    font-size: 13px;
    background: transparent;
}

/* ---------- Detail panel ---------- */

#DetailPanel {
    background-color: var(--detail-bg);
    border-bottom-right-radius: var(--radius-shell);
}

#DetailEmpty { background: transparent; }
#DetailEmptyIcon {
    color: var(--text-quaternary);
    background: transparent;
}
#DetailEmptyText {
    color: var(--text-tertiary);
    font-size: 13px;
    background: transparent;
}

#DetailHeader { background: transparent; margin-bottom: 8px; }
#DetailHeaderActions { background: transparent; }
#DetailIcon {
    background-color: var(--accent-soft);
    color: var(--accent);
    border-radius: var(--radius-2xl);
    font-size: 18px;
    font-weight: 700;
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
}
#DetailTitle {
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.2px;
}
#DetailTag {
    background-color: var(--primary-tint);
    color: var(--primary-accent-text);
    border-radius: var(--radius-full);
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 500;
}
#DetailSubtitle {
    color: var(--hint-2);
    font-size: 12px;
    background: transparent;
}
#DetailHeaderButton,
#DetailHeaderDeleteButton {
    background: transparent;
    color: var(--muted-2);
    border: none;
    border-radius: var(--radius-md);
    qproperty-minimumSize: 32px 32px;
    qproperty-maximumSize: 32px 32px;
    font-size: 12px;
    font-weight: 500;
}
#DetailHeaderButton:hover {
    background: var(--primary-hover-surface-3);
    color: var(--muted-2);
}

#DetailHeaderDeleteButton:hover {
    background: var(--danger-soft);
}

#DetailRiskyBanner {
    background-color: var(--warn-tint);
    color: var(--warn-text);
    border: 1px solid var(--warn-border);
    border-radius: var(--radius-xl);
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 500;
}
#DetailRiskyBannerText {
    background: transparent;
    color: var(--warn-text);
}

#DetailCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel-4);
    border-radius: var(--radius-xl);
    padding: 16px;
}
#DetailCardRow { background: transparent; }
#DetailCardDivider {
    background-color: var(--border-card);
    border: none;
    margin: 16px 0;
    min-height: 1px;
    max-height: 1px;
}

#DetailFieldLabel {
    color: var(--hint);
    font-size: 11px;
    font-weight: 500;
    background: transparent;
    margin-bottom: 8px;
}
#DetailFieldValue {
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}
#DetailFieldValueMono {
    color: var(--ink-2);
    font-size: 13px;
    font-family: "DM Mono", "JetBrains Mono", "Cascadia Mono", "Consolas", "Courier New", monospace;
    letter-spacing: 2.56px;
    background: transparent;
}
#DetailFieldValueLink {
    color: var(--link);
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

#DetailFieldButton {
    background: transparent;
    color: var(--muted-10);
    border: none;
    border-radius: var(--radius-md);
    padding: 4px 6px;
    min-width: 26px;
    min-height: 26px;
}
#DetailFieldButton:hover {
    background: var(--primary-hover-surface-3);
    color: var(--muted-10);
}

#DetailStampCard {
    background-color: var(--soft-bg);
    border: 1px solid var(--border-section);
    border-radius: var(--radius-xl);
    padding: 16px;
}
#DetailStampLabel {
    color: var(--muted-6);
    font-size: 11px;
    background: transparent;
}
#DetailStampValue {
    color: var(--muted-6);
    font-size: 11px;
    background: transparent;
}

#DetailPrimaryButton {
    background-color: var(--primary);
    color: var(--accent-fg);
    border: 1px solid var(--primary);
    border-radius: var(--radius-md);
    min-height: 36px;
    max-height: 36px;
    font-weight: 600;
    font-size: 12px;
}
#DetailPrimaryButton:hover {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}
#DetailPrimaryButton:pressed {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}
#DetailSecondaryButton {
    background-color: transparent;
    color: var(--body-2);
    border: 1px solid var(--border-panel);
    border-radius: var(--radius-md);
    min-height: 36px;
    max-height: 36px;
    font-weight: 500;
    font-size: 12px;
}
#DetailSecondaryButton:hover {
    background-color: var(--primary-hover-surface-6);
    border-color: var(--border-panel);
}

/* ---------- Legacy Category tree (kept for other dialogs) ---------- */
#CategoryTree {
    background: transparent;
    border: none;
    padding: 4px 8px;
}
#CategoryTree::item {
    padding: 8px 10px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
}
#CategoryTree::item:selected {
    background-color: var(--accent-soft);
    color: var(--accent);
}
#CategoryTree::item:hover:!selected {
    background-color: var(--bg-hover);
}

/* ---------- Detail eyebrow (legacy dialogs) ---------- */
#DetailField {
    color: var(--text-tertiary);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}
#DetailValue {
    color: var(--text-primary);
    font-size: 14px;
}
#DetailMonoValue {
    color: var(--text-primary);
    font-size: 13px;
    font-family: "DM Mono", "JetBrains Mono", "Cascadia Mono", "Consolas", "Courier New", monospace;
}

/* ---------- Empty state (legacy) ---------- */
#EmptyState {
    color: var(--text-tertiary);
    font-size: 14px;
    background: transparent;
}

/* ---------- Strength indicator ---------- */
#StrengthBar[level="1"]::chunk { background-color: var(--strength-weak); }
#StrengthBar[level="2"]::chunk { background-color: var(--strength-medium); }
#StrengthBar[level="3"]::chunk { background-color: var(--strength-strong); }

/* ---------- Toast ---------- */
#Toast,
#ToastSuccess,
#ToastWarning,
#ToastError {
    background-color: var(--toast-bg);
    color: var(--toast-fg);
    border-radius: var(--radius-xl);
    padding: 12px 16px;
    border: 1px solid var(--border-strong);
}
#ToastText {
    background: transparent;
    color: var(--toast-fg);
}

/* ---------- Legacy dialog headings ---------- */
#DialogTitle {
    color: var(--text-primary);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.4px;
}
#DialogSubtitle {
    color: var(--text-tertiary);
    font-size: 14px;
}

#FormError {
    color: var(--danger);
    font-size: 13px;
}

/* ---------- Import preview badges ---------- */
#Badge {
    color: var(--accent-fg);
    background: var(--accent);
    border-radius: var(--radius-full);
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 500;
}
#BadgeSuccess { background: var(--success); }
#BadgeWarning { background: var(--warning); color: var(--text-inverse); }
#BadgeDanger { background: var(--danger); }

/* ---------- Editor drawer ---------- */

#EditorPanel {
    background-color: var(--card);
    border-left: 1px solid var(--border-panel-2);
    border-top-right-radius: var(--radius-shell);
    border-bottom-right-radius: var(--radius-shell);
}

#EditorPage,
#EditorGeneratorPage,
#EditorPages {
    background-color: var(--card);
}

#EditorHeader,
#EditorGeneratorHeader {
    border-bottom: 1px solid var(--border-section-3);
}
#EditorHeaderTitle,
#EditorGeneratorHeaderTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.2px;
}
#EditorHeaderBack,
#EditorGeneratorBack,
#EditorHeaderClose,
#EditorGeneratorClose {
    background: transparent;
    color: var(--muted-7);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
}
#EditorHeaderBack:hover,
#EditorGeneratorBack:hover,
#EditorHeaderClose:hover,
#EditorGeneratorClose:hover {
    background: var(--primary-hover-surface);
    color: var(--primary);
}

#EditorContent,
#EditorBody,
#EditorScroll,
#EditorGeneratorContent,
#EditorGeneratorBody,
#EditorGeneratorScroll {
    background: transparent;
}

#EditorSectionTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
}

#EditorSectionDescription,
#EditorGeneratorDescription {
    color: var(--muted-13);
    font-size: 12px;
}

#EditorSectionDivider,
#EditorGeneratorDivider {
    background-color: var(--border-card);
    border: none;
}

#EditorFooter,
#EditorGeneratorFooter {
    border-top: 1px solid var(--border-drawer-inner);
    background-color: var(--card);
}

#EditorFooter QPushButton,
#EditorGeneratorFooter QPushButton {
    min-height: 36px;
    max-height: 36px;
    padding: 0 20px;
    border-radius: var(--radius-md);
    font-size: 12px;
    font-weight: 500;
}
#EditorFooter QPushButton[flat="true"],
#EditorGeneratorFooter QPushButton[flat="true"] {
    background-color: transparent;
    color: var(--muted-3);
    border: 1px solid var(--border-panel);
}
#EditorFooter QPushButton[flat="true"]:hover,
#EditorGeneratorFooter QPushButton[flat="true"]:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-strong);
}
#EditorFooter QPushButton[accent="true"],
#EditorGeneratorFooter QPushButton[accent="true"] {
    background-color: var(--primary);
    color: var(--accent-fg);
    border: 1px solid var(--primary);
}
#EditorFooter QPushButton[accent="true"]:hover,
#EditorGeneratorFooter QPushButton[accent="true"]:hover {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}
#EditorFooter QPushButton[accent="true"]:pressed,
#EditorGeneratorFooter QPushButton[accent="true"]:pressed {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}

#EditorGenerateButton {
    background-color: transparent;
    color: var(--accent);
    border: none;
    padding: 0;
    font-size: 11px;
    font-weight: 600;
}
#EditorGenerateButton:hover {
    background-color: transparent;
    color: var(--accent);
}
#EditorGenerateButton:pressed {
    background-color: transparent;
}

#EditorFieldLabel {
    color: var(--muted-11);
    font-size: 11px;
    font-weight: 500;
    margin: 0;
}

#EditorBody QLineEdit,
#EditorBody QComboBox {
    background-color: var(--bg-canvas);
    color: var(--ink-2);
    border-color: var(--border-panel);
    min-height: 36px;
    max-height: 36px;
    padding: 0 8px;
    border-radius: 8px;
    font-size: 12px;
}

#EditorBody QLineEdit[error="true"] {
    background-color: var(--danger-soft);
    border-color: var(--danger);
}

#EditorBody QLabel[validation-error="true"] {
    color: var(--danger);
    font-size: 10px;
}

#EditorBody QTextEdit {
    background-color: var(--bg-canvas);
    color: var(--body);
    border-color: var(--border-panel);
    padding: 8px;
    border-radius: 8px;
    font-size: 12px;
}

#EditorPasswordField {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-panel);
    border-radius: 8px;
}
#EditorPasswordField[error="true"] {
    background-color: var(--danger-soft);
    border-color: var(--danger);
}

#EditorPasswordField #EditorPasswordInput {
    background: transparent;
    border: none;
    padding: 0;
}

#EditorPreviewToggle {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
#EditorPreviewToggle:hover {
    background-color: var(--primary-hover-surface);
}

#EditorBody QFrame[strength-segment="true"][filled="true"] {
    background-color: var(--primary-strength-bar);
}

#EditorGeneratorTitle,
#EditorGeneratorGroupTitle,
#EditorGeneratorOptionsTitle {
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 600;
}

#EditorGeneratorTitle {
    font-size: 14px;
    margin-bottom: 4px;
}

#EditorGeneratorDescription {
    margin-bottom: 20px;
}

#EditorGeneratorPreviewCard {
    background-color: var(--soft-bg-sync);
    border: 1px solid var(--border-panel);
    border-radius: 12px;
    margin-bottom: 24px;
}

#EditorGeneratorPreview {
    background: transparent;
    color: var(--ink-2);
    border: none;
    padding: 0;
    font-size: 14px;
}

#EditorGeneratorRefresh {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

#EditorGeneratorRefresh:hover {
    background-color: var(--primary-hover-surface);
}

#EditorGeneratorLengthValue {
    background-color: var(--primary-tint);
    color: var(--primary);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 11px;
}

#EditorGeneratorLengthSlider {
    margin-top: 12px;
}

#EditorGeneratorHint {
    color: var(--hint);
    font-size: 10px;
}

#EditorGeneratorDivider {
    margin-top: 24px;
    margin-bottom: 16px;
}

#EditorGeneratorOptionsTitle {
    margin-bottom: 8px;
}

#EditorGeneratorOption {
    background: transparent;
    border-radius: 8px;
}

#EditorGeneratorOption:hover {
    background-color: var(--bg-hover);
}

#EditorGeneratorError {
    color: var(--danger);
    font-size: 11px;
    margin-top: 8px;
}

#EditorPlaceholder {
    color: var(--text-tertiary);
    font-size: 13px;
}

/* ---------- Preferences page (Phase 5) ---------- */

#PreferencesPage {
    background-color: var(--bg-canvas);
    border-top-right-radius: var(--radius-shell);
    border-bottom-right-radius: var(--radius-shell);
}

#PreferencesHeader {
    background: transparent;
    min-height: 68px;
    max-height: 68px;
}
#PreferencesHeaderControls { background: transparent; }
#PreferencesHeaderDivider {
    background-color: var(--border-section);
    border: none;
}
#PreferencesHeaderTitle {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.3px;
}
#PreferencesBack {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--muted-2);
}
#PreferencesBack:hover {
    background: var(--primary-hover-surface);
    color: var(--text-primary);
}

#PreferencesScroll { background: transparent; border: none; }
#PreferencesBody { background: transparent; }

#PreferencesOuterCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel-3);
    border-radius: var(--radius-2xl);
}

QTabWidget#PreferencesTabs::pane {
    border: none;
    border-top: 1px solid var(--border-section-4);
    background: transparent;
}
QTabWidget#PreferencesTabs QTabBar {
    background: transparent;
    border: none;
}
QTabWidget#PreferencesTabs QTabBar::tab {
    background: transparent;
    color: var(--hint-6);
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 500;
    border: none;
    border-bottom: 2px solid transparent;
    margin: 0;
}
QTabWidget#PreferencesTabs QTabBar::tab:hover {
    color: var(--muted-15);
}
QTabWidget#PreferencesTabs QTabBar::tab:selected {
    color: var(--primary);
    font-weight: 600;
    border-bottom: 2px solid var(--primary);
}

#PreferencesTabPage { background: transparent; }

#SettingRow { background: transparent; }
#SettingRowIcon {
    background-color: var(--primary-hover-surface-3);
    border-radius: var(--radius-2xl);
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}
#SettingRowTitle {
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#SettingRowDesc {
    color: var(--hint-6);
    font-size: 12px;
    background: transparent;
}
#SettingRowStatus {
    color: var(--hint-6);
    font-size: 12px;
    background: transparent;
}
#SettingRowSeparator {
    background-color: var(--border-section-4);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

#HelloToggle {
    background: transparent;
    color: var(--ink);
    font-size: 13px;
    spacing: 8px;
}

/* ---------- Legacy dialogs (Phase 6) ---------- */

#MasterPasswordDialog,
#GeneratorDialog,
#OAuthWizardDialog,
#ImportPreviewDialog {
    background-color: var(--shell);
}

#OAuthDescriptionCard {
    background-color: var(--soft-bg);
    border: 1px solid var(--border-section);
    border-radius: var(--radius-xl);
    padding: 14px 16px;
}
#OAuthDescriptionCard QLabel {
    background: transparent;
    color: var(--body);
    font-size: 12px;
}
#OAuthStatus {
    color: var(--hint-6);
    font-size: 12px;
    background: transparent;
}

QTabWidget#ImportPreviewTabs::pane {
    border: none;
    border-top: 1px solid var(--border-section-4);
    background: transparent;
}
QTabWidget#ImportPreviewTabs QTabBar {
    background: transparent;
    border: none;
}
QTabWidget#ImportPreviewTabs QTabBar::tab {
    background: transparent;
    color: var(--hint-6);
    padding: 12px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 500;
    margin: 0;
}
QTabWidget#ImportPreviewTabs QTabBar::tab:hover {
    color: var(--muted-15);
}
QTabWidget#ImportPreviewTabs QTabBar::tab:selected {
    color: var(--primary);
    border-bottom: 2px solid var(--primary);
    font-weight: 600;
}
