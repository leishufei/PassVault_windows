/* PassVault application-specific styles (Notion design system). */

/* ---------- Workspace shell ---------- */

QMainWindow, #WorkspaceRoot {
    background-color: var(--bg-primary);
}

#WorkspaceContainer {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border);
    border-radius: 0px;
}

#WorkspaceContainer > QWidget {
    background: transparent;
}

/* ---------- Sidebar ---------- */

#Sidebar {
    background-color: var(--bg-sidebar);
    border-right: 1px solid var(--border-sidebar);
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}
#Sidebar QLabel { background: transparent; }

/* Primary workspace CTA: Notion pill button (#0075de / pressed #005bab, stadium 20px). */
#NewPasswordButton {
    background-color: var(--primary);
    color: var(--accent-fg);
    border: 1px solid var(--primary);
    border-radius: 20px;
    padding: 0 16px;
    min-height: 40px;
    max-height: 40px;
    font-weight: 600;
    font-size: 14px;
}
#NewPasswordButton:hover {
    background-color: var(--accent-hover);
    border-color: var(--accent-hover);
}
#NewPasswordButton:pressed {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}

#SidebarSectionList, #SidebarCategoryList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}
#SidebarSectionList::item, #SidebarCategoryList::item {
    padding: 0 12px;
    min-height: 36px;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    margin: 0;
}
#SidebarSectionList::item:hover, #SidebarCategoryList::item:hover {
    background-color: var(--primary-hover-surface);
    color: var(--text-primary);
}
#SidebarSectionList::item:selected, #SidebarCategoryList::item:selected {
    background-color: var(--primary-tint);
    color: var(--primary-text-on-tint);
    font-weight: 600;
}
#SidebarCategoryList::item {
    min-height: 34px;
}

#SidebarDivider {
    background-color: var(--border-sidebar-2);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

#SidebarSectionHeader {
    color: var(--text-tertiary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.125px;
    padding: 0 4px;
}

#SidebarAddCategoryButton {
    color: var(--muted-5);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    padding: 0;
}
#SidebarAddCategoryButton:hover {
    background: var(--border-nav-hover);
    color: var(--text-primary);
}

#SidebarFooter {
    background: transparent;
    border-top: 1px solid var(--border-sidebar-2);
}

#SidebarSettingsButton, #SidebarSyncButton {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0 12px;
    min-height: 36px;
    max-height: 36px;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
}
#SidebarSyncButton[state="error"] {
    color: var(--danger-text);
}
#SidebarSyncButton[state="conflict"] {
    color: var(--warn-text);
}
#SidebarSettingsButton:hover:enabled, #SidebarSyncButton:hover:enabled {
    background: var(--primary-hover-surface);
    color: var(--text-primary);
}
#SidebarSettingsButton:focus, #SidebarSyncButton:focus {
    border-color: var(--primary-focus-border);
}
#SidebarSettingsButton:pressed:enabled, #SidebarSyncButton:pressed:enabled {
    background: var(--bg-muted);
}

/* ---------- Password list column ---------- */

#PasswordListColumn {
    background-color: var(--bg-canvas);
    border-right: 1px solid var(--border);
}

#VaultWorkspaceHeader {
    background-color: var(--bg-canvas);
    border-top-right-radius: 0px;
    min-height: 64px;
    max-height: 64px;
}

#VaultWorkspaceHeaderControls { background: transparent; }
#VaultWorkspaceHeaderDivider {
    background-color: var(--border);
    border: none;
}

/* Notion text-input: white surface, 1px #dddddd border, tight 4px radius. */
#SearchBarContainer {
    background-color: var(--input-bg);
    border-radius: var(--radius-xs);
    border: 1px solid var(--border-input);
}
#SearchBarContainer[focused="true"] {
    border-color: var(--focus-ring);
    background-color: var(--input-bg);
}
#SearchBar {
    padding: 0 6px 0 8px;
    min-height: 34px;
    max-height: 34px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 13px;
}
#SearchBar::placeholder {
    color: var(--placeholder);
}
#SearchShortcut {
    min-width: 64px;
    max-width: 64px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    background-color: var(--soft-bg);
    color: var(--text-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 11px;
}

#HeaderLockButton, #HeaderNavigationButton, #HeaderBackToListButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
    color: var(--text-secondary);
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
#HeaderLockButton:hover, #HeaderNavigationButton:hover,
#HeaderBackToListButton:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

#HeaderSeparator {
    background: var(--border);
    margin: 0 4px;
    border: none;
}

#HeaderMoreButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
    color: var(--text-tertiary);
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}
#HeaderMoreButton:hover {
    background: var(--bg-hover);
}

#ListTitleRow { background: transparent; }
#ListTitle {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.25px;
}
#ListCount {
    color: var(--text-tertiary);
    font-size: 12px;
    font-weight: 500;
}
#RestoreSelectedButton,
#PermanentlyDeleteButton,
#EmptyTrashButton,
#ListSortMenu {
    background: transparent;
    color: var(--text-tertiary);
    border: none;
    padding: 0 6px;
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
    font-weight: 500;
    border-radius: var(--radius-md);
}
#RestoreSelectedButton:hover,
#PermanentlyDeleteButton:hover,
#EmptyTrashButton:hover,
#ListSortMenu:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
}

#PasswordList {
    background: transparent;
    border: none;
    /* QListWidget spacing (6px) + 18px horizontal padding = 24px visual inset. */
    padding: 6px 18px 20px 18px;
    outline: none;
}
#PasswordList::item {
    padding: 0;
    margin: 0;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-card);
    background: var(--card);
}
#PasswordList::item:hover {
    background-color: var(--card-hover);
    border-color: var(--border-card-hover);
}
#PasswordList::item:selected {
    background-color: var(--card-selected);
    border-color: var(--border-card-selected);
}
#PasswordList::item:focus {
    border: 2px solid var(--focus-ring);
}

#PasswordCard {
    background: transparent;
    border-radius: var(--radius-xl);
}
#PasswordCardIcon {
    border-radius: var(--radius-lg);
    font-size: 14px;
    font-weight: 700;
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
}
#PasswordCardIcon[colorIndex="0"] {
    background-color: var(--avatar-0-bg);
    color: var(--avatar-0-fg);
}
#PasswordCardIcon[colorIndex="1"] {
    background-color: var(--avatar-1-bg);
    color: var(--avatar-1-fg);
}
#PasswordCardIcon[colorIndex="2"] {
    background-color: var(--avatar-2-bg);
    color: var(--avatar-2-fg);
}
#PasswordCardIcon[colorIndex="3"] {
    background-color: var(--avatar-3-bg);
    color: var(--avatar-3-fg);
}
#PasswordCardIcon[colorIndex="4"] {
    background-color: var(--avatar-4-bg);
    color: var(--avatar-4-fg);
}
#PasswordCardIcon[colorIndex="5"] {
    background-color: var(--avatar-5-bg);
    color: var(--avatar-5-fg);
}
#PasswordCardTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
}
#PasswordCardMeta {
    color: var(--text-tertiary);
    font-size: 12px;
}
#PasswordCardTime {
    color: var(--text-quaternary);
    font-size: 11px;
    font-weight: 500;
}
#PasswordCardStar {
    background: transparent;
    border: none;
    padding: 0;
}
#PasswordCardRestoreButton {
    background-color: var(--card);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0 8px;
    font-size: 12px;
    font-weight: 500;
}
#PasswordCardRestoreButton:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
}
#PasswordListEmpty {
    color: var(--text-tertiary);
    font-size: 13px;
    background: transparent;
}

/* ---------- Detail panel ---------- */

#DetailPanel {
    background-color: var(--detail-bg);
    border-left: 1px solid var(--border-panel-2);
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

#DetailScroll,
#DetailContent { background-color: transparent; }

#PasswordCardDeleteButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
}
#PasswordCardDeleteButton:hover { background-color: var(--danger-soft); }

#DetailEmpty { background: transparent; }
#DetailEmptyIcon {
    color: var(--text-quaternary);
    background: transparent;
}
#DetailEmptyText {
    color: var(--text-tertiary);
    font-size: 13px;
    background: transparent;
}

#DetailHeader { background: transparent; }
#DetailHeaderActions { background: transparent; }
#DetailIcon {
    background-color: var(--avatar-0-bg);
    color: var(--avatar-0-fg);
    border: none;
    border-radius: var(--radius-xl);
    font-size: 18px;
    font-weight: 700;
    min-width: 48px;
    max-width: 48px;
    min-height: 48px;
    max-height: 48px;
}
#DetailIcon[colorIndex="0"] {
    background-color: var(--avatar-0-bg);
    color: var(--avatar-0-fg);
}
#DetailIcon[colorIndex="1"] {
    background-color: var(--avatar-1-bg);
    color: var(--avatar-1-fg);
}
#DetailIcon[colorIndex="2"] {
    background-color: var(--avatar-2-bg);
    color: var(--avatar-2-fg);
}
#DetailIcon[colorIndex="3"] {
    background-color: var(--avatar-3-bg);
    color: var(--avatar-3-fg);
}
#DetailIcon[colorIndex="4"] {
    background-color: var(--avatar-4-bg);
    color: var(--avatar-4-fg);
}
#DetailIcon[colorIndex="5"] {
    background-color: var(--avatar-5-bg);
    color: var(--avatar-5-fg);
}
#DetailTitle {
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
}
#DetailTag {
    background-color: var(--primary-tint);
    color: var(--primary);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.125px;
}
#DetailSubtitle {
    color: var(--hint-2);
    font-size: 12px;
    background: transparent;
}
#DetailHeaderButton,
#DetailHeaderDeleteButton,
#DetailCloseButton {
    background: transparent;
    color: var(--text-secondary);
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    min-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 12px;
    font-weight: 500;
}
#DetailHeaderButton:hover,
#DetailCloseButton:hover {
    background: var(--primary-hover-surface-3);
    color: var(--text-primary);
}

#DetailHeaderDeleteButton:hover {
    background: var(--danger-soft);
    color: var(--danger);
}

#DetailRiskyBanner {
    background-color: var(--warn-tint);
    color: var(--warn-text);
    border: 1px solid var(--warn-border);
    border-radius: var(--radius-xl);
    padding: 10px 12px;
    font-size: 12px;
    font-weight: 500;
}
#DetailRiskyBannerText {
    background: transparent;
    color: var(--warn-text);
}

#DetailCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel-4);
    border-radius: var(--radius-xl);
    padding: 20px 18px;
}
#DetailCardRow { background: transparent; }
#DetailCardDivider {
    background-color: var(--border-card);
    border: none;
    margin: 0;
    min-height: 1px;
    max-height: 1px;
}

#DetailFieldLabel {
    color: var(--text-tertiary);
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    margin: 0;
}
#DetailFieldValue,
#DetailTitleValue,
#DetailNotesValue,
#DetailCategoryValue {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    background: transparent;
}
#DetailFieldValueMono {
    color: var(--text-primary);
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 14px;
    font-weight: 500;
    background: transparent;
}
#DetailFieldValueLink {
    color: var(--link);
    font-size: 14px;
    font-weight: 500;
    background: transparent;
}

#DetailFieldButton {
    background: transparent;
    color: var(--text-tertiary);
    border: none;
    border-radius: var(--radius-sm);
    padding: 0;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
}
#DetailFieldButton:hover {
    background: var(--primary-hover-surface-3);
    color: var(--text-primary);
}

#DetailStampCard {
    background-color: var(--soft-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 18px 18px;
}
#DetailStampLabel {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#DetailStampValue {
    color: var(--text-secondary);
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 12px;
    background: transparent;
}

/* ---------- Legacy Category tree (kept for other dialogs) ---------- */
#CategoryTree {
    background: transparent;
    border: none;
    padding: 4px 8px;
}
#CategoryTree::item {
    padding: 8px 10px;
    border-radius: var(--radius-md);
    color: var(--text-primary);
}
#CategoryTree::item:selected {
    background-color: var(--accent-soft);
    color: var(--accent);
}
#CategoryTree::item:hover:!selected {
    background-color: var(--bg-hover);
}

/* ---------- Detail eyebrow (legacy dialogs) ---------- */
#DetailField {
    color: var(--text-tertiary);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4px;
}
#DetailValue {
    color: var(--text-primary);
    font-size: 14px;
}
#DetailMonoValue {
    color: var(--text-primary);
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 14px;
}

/* ---------- Empty state (legacy) ---------- */
#EmptyState {
    color: var(--text-tertiary);
    font-size: 14px;
    background: transparent;
}

/* ---------- Strength indicator ---------- */
#StrengthBar[level="1"]::chunk { background-color: var(--strength-weak); }
#StrengthBar[level="2"]::chunk { background-color: var(--strength-medium); }
#StrengthBar[level="3"]::chunk { background-color: var(--strength-strong); }

/* ---------- Toast ---------- */
#Toast,
#ToastSuccess,
#ToastWarning,
#ToastError {
    background-color: var(--toast-bg);
    color: var(--toast-fg);
    border-radius: var(--radius-xl);
    padding: 0;
    border: 1px solid var(--border-strong);
}
#ToastSuccess { border-color: var(--success); }
#ToastWarning { border-color: var(--warn); }
#ToastError { border-color: var(--danger); }
#ToastText {
    background: transparent;
    color: var(--toast-fg);
}

/* ---------- Legacy dialog headings ---------- */
#DialogTitle {
    color: var(--text-primary);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
}
#DialogSubtitle {
    color: var(--text-tertiary);
    font-size: 13px;
}

#FormError {
    color: var(--danger);
    font-size: 12px;
}

/* ---------- Import preview badges ---------- */
#Badge {
    color: var(--accent-fg);
    background: var(--accent);
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.125px;
}
#BadgeSuccess { background: var(--success); }
#BadgeWarning { background: var(--warning); color: var(--text-inverse); }
#BadgeDanger { background: var(--danger); }

/* ---------- Editor drawer ---------- */

#EditorPanel {
    background-color: var(--card);
    border-left: 1px solid var(--border-panel-2);
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

#EditorPage,
#EditorGeneratorPage,
#EditorPages {
    background-color: var(--card);
}

#EditorHeader,
#EditorGeneratorHeader {
    border-bottom: 1px solid var(--border-section-3);
}
#EditorHeaderTitle,
#EditorGeneratorHeaderTitle {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.25px;
}
#EditorHeaderBack,
#EditorGeneratorBack,
#EditorHeaderClose,
#EditorGeneratorClose {
    background: transparent;
    color: var(--muted-7);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    padding: 0;
}
#EditorHeaderBack:hover,
#EditorGeneratorBack:hover,
#EditorHeaderClose:hover,
#EditorGeneratorClose:hover {
    background: var(--primary-hover-surface);
    color: var(--primary);
}

#EditorContent,
#EditorBody,
#EditorScroll,
#EditorGeneratorContent,
#EditorGeneratorBody,
#EditorGeneratorScroll {
    background: transparent;
}

#EditorSectionTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
}

#EditorGeneratorDescription {
    color: var(--text-tertiary);
    font-size: 12px;
}

#EditorSectionDivider,
#EditorGeneratorDivider {
    background-color: var(--border-card);
    border: none;
}

#EditorFooter,
#EditorGeneratorFooter {
    border-top: 1px solid var(--border-drawer-inner);
    background-color: var(--card);
}

#EditorFooter QPushButton,
#EditorGeneratorFooter QPushButton {
    min-height: 36px;
    max-height: 36px;
    padding: 0 18px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
}
#EditorFooter QPushButton[flat="true"],
#EditorGeneratorFooter QPushButton[flat="true"] {
    background-color: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-panel);
}
#EditorFooter QPushButton[flat="true"]:hover,
#EditorGeneratorFooter QPushButton[flat="true"]:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-strong);
}
#EditorFooter QPushButton[accent="true"],
#EditorGeneratorFooter QPushButton[accent="true"] {
    background-color: var(--primary);
    color: var(--accent-fg);
    border: 1px solid var(--primary);
}
#EditorFooter QPushButton[accent="true"]:hover,
#EditorGeneratorFooter QPushButton[accent="true"]:hover {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}
#EditorFooter QPushButton[accent="true"]:pressed,
#EditorGeneratorFooter QPushButton[accent="true"]:pressed {
    background-color: var(--primary-pressed);
    border-color: var(--primary-pressed);
}

#EditorGenerateButton {
    background-color: transparent;
    color: var(--accent);
    border: none;
    padding: 0 2px;
    font-size: 12px;
    font-weight: 600;
}
#EditorGenerateButton:hover {
    background-color: transparent;
    color: var(--accent-hover);
}
#EditorGenerateButton:pressed {
    background-color: transparent;
}

#EditorFieldLabel {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
    margin: 0;
}

#EditorBody QLineEdit {
    background-color: var(--input-bg);
    color: var(--text-primary);
    border-color: var(--border-input);
    min-height: 36px;
    max-height: 36px;
    padding: 0 12px;
    border-radius: 4px;
    font-size: 14px;
}
#EditorBody QLineEdit:focus {
    border-color: var(--focus-ring);
}

#EditorBody QComboBox {
    background-color: var(--input-bg);
    color: var(--text-primary);
    border-color: var(--border-input);
    min-height: 36px;
    max-height: 36px;
    padding: 0 30px 0 12px;
    border-radius: 4px;
    font-size: 14px;
}
#EditorBody QComboBox:focus {
    border-color: var(--focus-ring);
}

#EditorBody QLineEdit[error="true"] {
    background-color: var(--danger-soft);
    border-color: var(--danger);
}

#EditorBody QLabel[validation-error="true"] {
    color: var(--danger);
    font-size: 12px;
}

#EditorBody QTextEdit {
    background-color: var(--input-bg);
    color: var(--text-primary);
    border-color: var(--border-input);
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 14px;
}
#EditorBody QTextEdit:focus {
    border-color: var(--focus-ring);
}

#EditorPasswordField {
    background-color: var(--input-bg);
    border: 1px solid var(--border-input);
    border-radius: 4px;
}
#EditorPasswordField[error="true"] {
    background-color: var(--danger-soft);
    border-color: var(--danger);
}

#EditorPasswordField #EditorPasswordInput {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 34px;
    max-height: 34px;
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 14px;
}

#EditorPreviewToggle {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}
#EditorPreviewToggle:hover {
    background-color: var(--primary-hover-surface);
}

#EditorBody QFrame[strength-segment="true"][filled="true"] {
    background-color: var(--primary-strength-bar);
}

#EditorGeneratorTitle,
#EditorGeneratorGroupTitle,
#EditorGeneratorOptionsTitle {
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
}

#EditorGeneratorTitle {
    font-size: 15px;
    margin-bottom: 4px;
}

#EditorGeneratorDescription {
    margin-bottom: 20px;
}

#EditorGeneratorPreviewCard {
    background-color: var(--soft-bg-sync);
    border: 1px solid var(--border-panel);
    border-radius: 12px;
    margin-bottom: 24px;
}

#EditorGeneratorPreview {
    background: transparent;
    color: var(--text-primary);
    border: none;
    padding: 0;
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 15px;
}

#EditorGeneratorRefresh {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0;
}

#EditorGeneratorRefresh:hover {
    background-color: var(--primary-hover-surface);
}

#EditorGeneratorLengthValue {
    background-color: var(--primary-tint);
    color: var(--primary);
    border-radius: 5px;
    padding: 3px 8px;
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 11px;
    font-weight: 600;
}

#EditorGeneratorLengthSlider {
    margin-top: 12px;
}

#EditorGeneratorHint {
    color: var(--text-tertiary);
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 11px;
}

#EditorGeneratorDivider {
    margin-top: 24px;
    margin-bottom: 16px;
}

#EditorGeneratorOptionsTitle {
    margin-bottom: 8px;
}

#EditorGeneratorOption {
    background: transparent;
    border-radius: 8px;
}

#EditorGeneratorOption:hover {
    background-color: var(--bg-hover);
}

#EditorGeneratorError {
    color: var(--danger);
    font-size: 12px;
    margin-top: 8px;
}

#EditorPlaceholder {
    color: var(--text-tertiary);
    font-size: 13px;
}

/* ---------- Preferences page (Phase 5) ---------- */

#PreferencesPage {
    background-color: var(--bg-canvas);
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

#PreferencesHeader {
    background: transparent;
    min-height: 64px;
    max-height: 64px;
}
#PreferencesHeaderControls { background: transparent; }
#PreferencesHeaderDivider {
    background-color: var(--border-section);
    border: none;
}
#PreferencesHeaderTitle {
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.25px;
}
#PreferencesBack {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    color: var(--muted-2);
    padding: 0;
}
#PreferencesBack:hover {
    background: var(--primary-hover-surface);
    color: var(--text-primary);
}

#PreferencesScroll { background: transparent; border: none; }
#PreferencesBody { background: transparent; }

#PreferencesOuterCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel-3);
    border-radius: var(--radius-2xl);
}

QTabWidget#PreferencesTabs::pane {
    border: none;
    border-top: 1px solid var(--border-section-4);
    background: transparent;
}
QTabWidget#PreferencesTabs QTabBar {
    background: transparent;
    border: none;
}
QTabWidget#PreferencesTabs QTabBar::tab {
    background: transparent;
    color: var(--text-tertiary);
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 500;
    border: none;
    border-bottom: 2px solid transparent;
    margin: 0;
}
QTabWidget#PreferencesTabs QTabBar::tab:hover {
    color: var(--text-primary);
}
QTabWidget#PreferencesTabs QTabBar::tab:selected {
    color: var(--primary);
    font-weight: 600;
    border-bottom: 2px solid var(--primary);
}

#PreferencesTabPage { background: transparent; }

#SettingRow { background: transparent; }
#SettingRowIcon {
    background-color: var(--soft-bg);
    border: 1px solid var(--border-section);
    border-radius: var(--radius-md);
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
}
#SettingRowTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#SettingRowDesc {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#SettingRowStatus {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#SettingRowSeparator {
    background-color: var(--border-section-4);
    border: none;
    min-height: 1px;
    max-height: 1px;
}

#SettingSectionHeader { background: transparent; }
#SettingSectionTitle {
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* ---------- Security page ---------- */
#SecurityPageTitle {
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}
#SecurityPageDescription {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#SecurityDangerZone { background: transparent; }
#SecurityDangerTitle {
    color: var(--danger-text);
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#SecurityDangerDescription {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#ChangeMasterButton {
    border-radius: 8px;
    padding: 0 14px;
    min-height: 36px;
    max-height: 36px;
    font-size: 13px;
}
#ClearLocalDataButton {
    background: transparent;
    color: var(--danger-text);
    border: 1px solid var(--danger-text);
    border-radius: 8px;
    padding: 0 14px;
    min-height: 36px;
    max-height: 36px;
    font-size: 13px;
    font-weight: 500;
}
#ClearLocalDataButton:hover {
    background-color: var(--danger-soft);
}
#ClearLocalDataButton:focus {
    border-color: var(--focus-ring);
}
#ClearLocalDataButton:disabled {
    background-color: transparent;
    color: var(--text-quaternary);
    border-color: var(--border-panel-3);
}
#ChangeMasterButton:disabled {
    color: var(--text-quaternary);
}

#SyncHeadingTitle {
    color: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}
#SyncHeadingDesc,
#SyncAuthDesc {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#SyncConnectionCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel-3);
    border-radius: 12px;
}
#SyncAuthCard,
#SyncAccountCard,
#SyncLastCard {
    background: transparent;
    border: none;
}
#SyncSectionDivider {
    background-color: var(--border-section-4);
    border: none;
}
#SyncGoogleMark {
    background-color: var(--card);
    color: var(--brand-google-fg);
    border: 1px solid var(--border-section-3);
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
}
#SyncAuthTitle,
#SyncAccountTitle {
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#SyncLastTitle {
    color: var(--text-secondary);
    font-size: 12px;
    background: transparent;
}
#SyncAccountEmail {
    color: var(--text-tertiary);
    font-size: 12px;
    background: transparent;
}
#SyncLastValue {
    color: var(--text-primary);
    font-family: "DM Mono", "Inter Variable", "Noto Sans SC";
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}
#SyncStateText {
    color: var(--text-secondary);
    font-size: 12px;
    background: transparent;
}
#SyncStateDot {
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}
#SyncStateDot[state="idle"]     { background-color: var(--muted-13); }
#SyncStateDot[state="busy"]     { background-color: var(--warn); }
#SyncStateDot[state="ok"]       { background-color: var(--success); }
#SyncStateDot[state="conflict"] { background-color: var(--warn); }
#SyncStateDot[state="error"]    { background-color: var(--danger); }
#DriveConnectButton,
#AccountRetryButton,
#DriveDisconnectButton,
#SyncNowButton,
#AuthorizeCancelButton,
#ChangeAccountButton {
    border-radius: 8px;
    padding: 0 14px;
    min-height: 36px;
    max-height: 36px;
    font-size: 13px;
    font-weight: 500;
}

#HelloToggle {
    background: transparent;
    color: var(--ink);
    font-size: 13px;
    spacing: 8px;
}

/* ---------- Master password dialogs ---------- */

#MasterPasswordDialog { background: transparent; }
#MasterPasswordBackdrop { background-color: var(--dialog-backdrop); }
#MasterPasswordCard {
    background-color: var(--card);
    border: 1px solid var(--border-panel);
    border-radius: 16px;
}
#MasterPasswordHeader {
    background: transparent;
    border-bottom: 1px solid var(--border-section-3);
}
#MasterPasswordIcon {
    background-color: var(--soft-bg);
    border: 1px solid var(--border-section);
    border-radius: 8px;
}
#MasterPasswordDialog #DialogTitle {
    background: transparent;
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.25px;
}
#MasterPasswordClose {
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
}
#MasterPasswordClose:hover {
    background-color: var(--bg-hover);
}
#MasterPasswordClose:focus {
    border-color: var(--focus-ring);
}
#MasterPasswordBody { background: transparent; }
#MasterPasswordDialog #DialogSubtitle {
    background: transparent;
    color: var(--text-tertiary);
    font-size: 13px;
}
#MasterPasswordFieldLabel {
    background: transparent;
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 500;
}
#MasterPasswordDialog QLineEdit {
    background-color: var(--input-bg);
    color: var(--text-primary);
    border: 1px solid var(--border-input);
    border-radius: 4px;
    padding: 0 12px;
    min-height: 36px;
    max-height: 36px;
    font-size: 14px;
}
#MasterPasswordDialog QLineEdit:focus {
    border-color: var(--focus-ring);
}
#MasterPasswordDialog #PreviewCheckbox {
    color: var(--text-secondary);
    font-size: 12px;
}
#MasterPasswordDialog #PreviewCheckbox::indicator:focus {
    border-color: var(--focus-ring);
}
#MasterPasswordFooter {
    background: transparent;
    border-top: 1px solid var(--border-drawer-inner);
}
#MasterPasswordFooter QPushButton {
    padding: 0 18px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 8px;
    font-size: 14px;
}
#MasterPasswordDialog QPushButton:focus {
    border-color: var(--focus-ring);
}

/* ---------- Legacy dialogs (Phase 6) ---------- */

#GeneratorDialog,
#OAuthWizardDialog,
#ImportPreviewDialog {
    background-color: var(--shell);
}

#OAuthDescriptionCard {
    background-color: var(--soft-bg);
    border: 1px solid var(--border-section);
    border-radius: var(--radius-xl);
    padding: 14px 16px;
}
#OAuthDescriptionCard QLabel {
    background: transparent;
    color: var(--body);
    font-size: 13px;
}
#OAuthStatus {
    color: var(--hint-6);
    font-size: 12px;
    background: transparent;
}

QTabWidget#ImportPreviewTabs::pane {
    border: none;
    border-top: 1px solid var(--border-section-4);
    background: transparent;
}
#ImportPreviewNotice {
    background-color: var(--soft-bg-sync);
    color: var(--body);
    border: 1px solid var(--border-panel);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 12px;
}
#ImportPreviewEmpty {
    background: transparent;
    color: var(--text-tertiary);
    font-size: 13px;
}
QTabWidget#ImportPreviewTabs QTabBar {
    background: transparent;
    border: none;
}
QTabWidget#ImportPreviewTabs QTabBar::tab {
    background: transparent;
    color: var(--hint-6);
    padding: 12px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
    font-weight: 500;
    margin: 0;
}
QTabWidget#ImportPreviewTabs QTabBar::tab:hover {
    color: var(--muted-15);
}
QTabWidget#ImportPreviewTabs QTabBar::tab:selected {
    color: var(--primary);
    border-bottom: 2px solid var(--primary);
    font-weight: 600;
}
