/* PassVault design tokens - light theme. */
/* cc-switch design language: neutral gray structure (white canvas and card */
/* surfaces, zinc text ramp) with a single blue action color (#0075de). */
/* Blue is reserved for primary buttons, switches, focus rings, links and */
/* action text and password card selection; navigation stays neutral gray. */
/* Existing semantic aliases (--bg-*, --text-*, --border-*, --accent-*, */
/* --danger-*, --success-*, --strength-*, --toast-*, --focus-ring, --shadow) */
/* are preserved so downstream QSS and C++ token lookups keep working. */

* {
    /* ---- Primary / action family (blue action color) ---- */
    --primary: #0075de;
    --primary-pressed: #005bab;
    --primary-tint: #e7f1fb;
    --primary-tint-2: #d6e8f9;
    --primary-text-on-tint: #0068c6;
    --primary-accent-text: #0068c6;
    --primary-accent-alt: #0068c6;
    --primary-focus-border: #5aa2e8;
    --primary-hover-surface: #efeff2;
    --primary-hover-surface-2: #efeff2;
    --primary-hover-surface-3: #efeff2;
    --primary-hover-surface-4: #efeff2;
    --primary-hover-surface-5: #efeff2;
    --primary-hover-surface-6: #f5f5f7;
    --primary-tab-active-bg: #e4e4ea;
    --primary-strength-bar: #0075de;
    --primary-strength-text: #0068c6;
    --primary-icon-cloud: #52525b;
    --primary-icon-lock: #52525b;
    --primary-setting-icon: #52525b;
    --link: #0075de;

    /* ---- Surfaces / backgrounds (neutral canvas + white surfaces) ---- */
    --canvas: #ffffff;
    --shell: #ffffff;
    --detail-bg: #ffffff;
    --card: #ffffff;
    --card-selected: #e4e4ea;
    --card-hover: #efeff2;
    --soft-bg: #efeff2;
    --soft-bg-sync: #efeff2;
    --soft-bg-sync-auth: #efeff2;
    --soft-bg-select: #efeff2;
    --input-bg: #ffffff;

    /* Legacy aliases (used across components.qss / app.qss). */
    --bg-primary: #ffffff;
    --bg-canvas: #ffffff;
    --bg-elevated: #ffffff;
    --bg-sidebar: #f5f5f7;
    --bg-search: #ffffff;
    --bg-hover: #efeff2;
    --bg-muted: #efeff2;
    --bg-secondary: #f5f5f7;
    --bg-tertiary: #e4e4ea;

    /* ---- Text (zinc ramp: ink / body / muted / hint) ---- */
    --ink: #18181b;
    --ink-2: #27272a;
    --body: #52525b;
    --body-2: #65656e;
    --muted: #65656e;
    --muted-2: #65656e;
    --muted-3: #65656e;
    --muted-4: #65656e;
    --muted-5: #65656e;
    --muted-6: #65656e;
    --muted-7: #65656e;
    --muted-8: #71717a;
    --muted-9: #71717a;
    --muted-10: #71717a;
    --muted-11: #71717a;
    --muted-12: #71717a;
    --muted-13: #a1a1aa;
    --muted-14: #52525b;
    --muted-15: #18181b;
    --hint: #71717a;
    --hint-2: #71717a;
    --hint-3: #71717a;
    --hint-4: #71717a;
    --hint-5: #71717a;
    --hint-6: #71717a;
    --hint-7: #71717a;
    --hint-8: #a1a1aa;
    --hint-9: #71717a;
    --hint-10: #65656e;
    --placeholder: #65656e;
    --placeholder-2: #65656e;
    --placeholder-3: #65656e;
    --placeholder-4: #65656e;
    --info-value: #18181b;
    --detail-copy: #52525b;
    --detail-copy-2: #65656e;
    --external-icon: #0075de;

    /* Legacy text aliases. */
    --text-primary: #18181b;
    --text-secondary: #52525b;
    --text-tertiary: #65656e;
    --text-quaternary: #a1a1aa;
    --text-inverse: #ffffff;

    /* ---- Borders (neutral hairlines, never heavy frames) ---- */
    --border-shell: #e4e4e9;
    --border-section: #ececf0;
    --border-section-2: #ececf0;
    --border-section-3: #ececf0;
    --border-section-4: #ececf0;
    --border-panel: #e4e4e9;
    --border-panel-2: #e4e4e9;
    --border-panel-3: #e4e4e9;
    --border-panel-4: #e4e4e9;
    --border-sidebar: #e4e4e9;
    --border-sidebar-2: #e4e4e9;
    --border-nav-hover: #cfcfd6;
    --border-drawer-inner: #e4e4e9;
    --border-card: #e4e4e9;
    --border-card-hover: #cfcfd6;
    --border-card-selected: #0075de;
    --border-divider-hair: #ececf0;
    --border-input: #cfcfd6;

    /* Legacy border aliases. */
    --border: #e4e4e9;
    --border-strong: #cfcfd6;
    --border-soft: #efeff2;
    --border-tertiary: #efeff2;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #0075de;
    --accent-hover: #0069c8;
    --accent-pressed: #005bab;
    --accent-soft: #e7f1fb;
    --accent-soft-hover: #d6e8f9;
    --accent-fg: #ffffff;

    /* Avatar tiles: cc-switch mode/chart palette (decoration only). */
    --avatar-0-bg: #eaf3ff;
    --avatar-0-fg: #0063c7;
    --avatar-1-bg: #e7f6f4;
    --avatar-1-fg: #06726b;
    --avatar-2-bg: #f2ecfe;
    --avatar-2-fg: #6d28d9;
    --avatar-3-bg: #e0f2fe;
    --avatar-3-fg: #0891b2;
    --avatar-4-bg: #fce7f3;
    --avatar-4-fg: #db2777;
    --avatar-5-bg: #e8f4fd;
    --avatar-5-fg: #0b6bcb;

    /* ---- Semantic ---- */
    --success: #16a34a;
    --success-text: #007634;
    --success-tint: #e8f7ee;
    --success-soft: #e8f7ee;
    --warn: #d97706;
    --warn-text: #a64a00;
    --warn-tint: #fef3c7;
    --warn-border: #fde68a;
    --warning: #d97706;
    --danger-text: #b91c1c;
    --danger: #dc2626;
    --danger-hover: #b91c1c;
    --danger-soft: #fee2e2;
    --switch-off-disabled-icon: :/icons/switch-off-disabled.svg;
    --switch-on-disabled-icon: :/icons/switch-on-disabled.svg;
    --toggle-off-disabled: #c9c9cd;
    --toggle-on-disabled: #8cc1f0;
    --toggle-off: #888890;

    --strength-weak: #dc2626;
    --strength-medium: #d97706;
    --strength-strong: #16a34a;

    --toast-bg: #18181b;
    --toast-fg: #ffffff;

    --focus-ring: #5aa2e8;
    --shadow: rgba(16, 24, 40, 26);
    --dialog-shadow: #09090b;
    --dialog-backdrop: rgba(9, 9, 11, 92);

    /* ---- Brand tiles (password-card icon square) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (cc-switch rounded scale) ---- */
    /* xs 4: chips | sm 6: menu items, list rows | md 6: buttons */
    /* lg 10: avatar tiles | xl 10: cards | 2xl 14: large containers */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 6px;
    --radius-lg: 10px;
    --radius-xl: 10px;
    --radius-2xl: 14px;
    --radius-shell: 14px;
    --radius-full: 9999px;
}
