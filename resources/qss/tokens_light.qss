/* PassVault design tokens - light theme. */
/* Notion design language: warm paper canvas (#f6f5f4), near-black warm ink, */
/* a single structural accent (Notion blue #0075de), hairline (#e6e6e6) */
/* surfaces, and a decorative-only sticker palette for avatar tiles. */
/* Existing semantic aliases (--bg-*, --text-*, --border-*, --accent-*, */
/* --danger-*, --success-*, --strength-*, --toast-*, --focus-ring, --shadow) */
/* are preserved so downstream QSS and C++ token lookups keep working. */

* {
    /* ---- Brand / primary family (Notion blue, the only structural accent) ---- */
    --primary: #0075de;
    --primary-pressed: #005bab;
    --primary-tint: #e7f1fb;
    --primary-tint-2: #d6e8f9;
    --primary-text-on-tint: #0068c6;
    --primary-accent-text: #0068c6;
    --primary-accent-alt: #0068c6;
    --primary-focus-border: #5aa2e8;
    --primary-hover-surface: #efeeec;
    --primary-hover-surface-2: #efeeec;
    --primary-hover-surface-3: #f1f0ee;
    --primary-hover-surface-4: #f1f0ee;
    --primary-hover-surface-5: #efeeec;
    --primary-hover-surface-6: #f7f6f5;
    --primary-tab-active-bg: #e7f1fb;
    --primary-strength-bar: #0075de;
    --primary-strength-text: #0068c6;
    --primary-icon-cloud: #0075de;
    --primary-icon-lock: #0075de;
    --primary-setting-icon: #0075de;
    --link: #0075de;

    /* ---- Surfaces / backgrounds (warm paper + white document) ---- */
    --canvas: #f6f5f4;
    --shell: #ffffff;
    --detail-bg: #ffffff;
    --card: #ffffff;
    --card-selected: #e7f1fb;
    --card-hover: #f1f0ee;
    --soft-bg: #f6f5f4;
    --soft-bg-sync: #f6f5f4;
    --soft-bg-sync-auth: #f6f5f4;
    --soft-bg-select: #f6f5f4;
    --input-bg: #ffffff;

    /* Legacy aliases (used across components.qss / app.qss). */
    --bg-primary: #f6f5f4;
    --bg-canvas: #f6f5f4;
    --bg-elevated: #ffffff;
    --bg-sidebar: #f3f2ef;
    --bg-search: #ffffff;
    --bg-hover: #ecebe8;
    --bg-muted: #e6e5e2;
    --bg-secondary: #f3f2ef;
    --bg-tertiary: #e6e5e2;

    /* ---- Text (warm ink ramp: ink / charcoal / stone / ash) ---- */
    --ink: #191918;
    --ink-2: #31302e;
    --body: #31302e;
    --body-2: #4a4744;
    --muted: #615d59;
    --muted-2: #615d59;
    --muted-3: #615d59;
    --muted-4: #615d59;
    --muted-5: #615d59;
    --muted-6: #615d59;
    --muted-7: #615d59;
    --muted-8: #6f6b66;
    --muted-9: #6f6b66;
    --muted-10: #6f6b66;
    --muted-11: #6f6b66;
    --muted-12: #6f6b66;
    --muted-13: #a39e98;
    --muted-14: #4a4744;
    --muted-15: #31302e;
    --hint: #7d7873;
    --hint-2: #7d7873;
    --hint-3: #7d7873;
    --hint-4: #7d7873;
    --hint-5: #7d7873;
    --hint-6: #7d7873;
    --hint-7: #7d7873;
    --hint-8: #8a857f;
    --hint-9: #7d7873;
    --hint-10: #6f6b66;
    --placeholder: #a39e98;
    --placeholder-2: #a39e98;
    --placeholder-3: #a39e98;
    --placeholder-4: #a39e98;
    --info-value: #31302e;
    --detail-copy: #615d59;
    --detail-copy-2: #7d7873;
    --external-icon: #0075de;

    /* Legacy text aliases. */
    --text-primary: #191918;
    --text-secondary: #31302e;
    --text-tertiary: #615d59;
    --text-quaternary: #8e8983;
    --text-inverse: #ffffff;

    /* ---- Borders (hairlines, never heavy frames) ---- */
    --border-shell: #e6e6e6;
    --border-section: #ededec;
    --border-section-2: #ededec;
    --border-section-3: #ededec;
    --border-section-4: #ededec;
    --border-panel: #e6e6e6;
    --border-panel-2: #e6e6e6;
    --border-panel-3: #e6e6e6;
    --border-panel-4: #e6e6e6;
    --border-sidebar: #e5e4e1;
    --border-sidebar-2: #e5e4e1;
    --border-nav-hover: #e5e4e1;
    --border-drawer-inner: #e6e6e6;
    --border-card: #e6e6e6;
    --border-card-hover: #d8d7d4;
    --border-card-selected: #9ec8f2;
    --border-divider-hair: #ebeae7;
    --border-input: #dddddd;

    /* Legacy border aliases. */
    --border: #e6e6e6;
    --border-strong: #d9d8d5;
    --border-soft: #e9e8e6;
    --border-tertiary: #efeeec;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #0075de;
    --accent-hover: #0069c8;
    --accent-pressed: #005bab;
    --accent-soft: #e7f1fb;
    --accent-soft-hover: #d6e8f9;
    --accent-fg: #ffffff;

    /* Avatar tiles: Notion sticker palette (decoration only). */
    --avatar-0-bg: #e8f4fd;
    --avatar-0-fg: #0b6bcb;
    --avatar-1-bg: #e6f6ea;
    --avatar-1-fg: #15802d;
    --avatar-2-bg: #fdf0e6;
    --avatar-2-fg: #b84a00;
    --avatar-3-bg: #f3ecfc;
    --avatar-3-fg: #5b2d8a;
    --avatar-4-bg: #ffeaf7;
    --avatar-4-fg: #b82583;
    --avatar-5-bg: #e4f5f4;
    --avatar-5-fg: #1d7774;

    /* ---- Semantic (status carried by the sticker palette) ---- */
    --success: #1aae39;
    --success-text: #15862c;
    --success-tint: #e4f5e7;
    --success-soft: #e4f5e7;
    --warn: #dd5b00;
    --warn-text: #a84500;
    --warn-tint: #fdf2e9;
    --warn-border: #f5d6bd;
    --warning: #dd5b00;
    --danger-text: #c4362f;
    --danger: #d8413a;
    --danger-hover: #bd342e;
    --danger-soft: #fdebea;
    --toggle-off: #d9d8d5;

    --strength-weak: #d8413a;
    --strength-medium: #dd5b00;
    --strength-strong: #1aae39;

    --toast-bg: #2f2e2c;
    --toast-fg: #ffffff;

    --focus-ring: #5aa2e8;
    --shadow: rgba(15, 15, 15, 26);
    --dialog-shadow: #1c1b1a;
    --dialog-backdrop: rgba(15, 15, 15, 92);

    /* ---- Brand tiles (password-card icon square) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (Notion rounded scale) ---- */
    /* xs 4: inputs, chips | sm 5: menu items, list rows | md 8: buttons */
    /* lg 10: avatar tiles | xl 12: cards | 2xl 16: large containers */
    --radius-xs: 4px;
    --radius-sm: 5px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 12px;
    --radius-2xl: 16px;
    --radius-shell: 16px;
    --radius-full: 9999px;
}
