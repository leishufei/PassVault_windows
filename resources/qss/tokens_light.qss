/* PassVault design tokens - light theme. */
/* Full palette mirrored from design.md (Figma "Redesign Password Manager UI" */
/* light theme). Names use kebab-case; every hex kept lowercase. */
/* Existing semantic aliases (--bg-*, --text-*, --border-*, --accent-*, */
/* --danger-*, --success-*, --strength-*, --toast-*, --focus-ring, --shadow) */
/* are preserved so downstream QSS keeps working. */

* {
    /* ---- Brand / primary family (唯一结构色, Notion 蓝) ---- */
    --primary: #276cf0;
    --primary-pressed: #1d60df;
    --primary-tint: #e8f0ff;
    --primary-tint-2: #dbe9ff;
    --primary-text-on-tint: #2369ee;
    --primary-accent-text: #3777e7;
    --primary-accent-alt: #3675de;
    --primary-focus-border: #8ab3ff;
    --primary-hover-surface: #eaf0f8;
    --primary-hover-surface-2: #eaf2ff;
    --primary-hover-surface-3: #eef4ff;
    --primary-hover-surface-4: #eff4fa;
    --primary-hover-surface-5: #edf2f8;
    --primary-hover-surface-6: #f4f7fb;
    --primary-tab-active-bg: #e4efff;
    --primary-strength-bar: #2771ef;
    --primary-strength-text: #3979e7;
    --primary-icon-cloud: #4281f2;
    --primary-icon-lock: #3b78df;
    --primary-setting-icon: #3174e6;
    --link: #2771ed;

    /* ---- Surfaces / backgrounds ---- */
    --canvas: #eef2f7;
    --shell: #fbfcfe;
    --detail-bg: #ffffff;
    --card: #ffffff;
    --card-selected: #eef4ff;
    --card-hover: #f7faff;
    --soft-bg: #f6f9fc;
    --soft-bg-sync: #f7faff;
    --soft-bg-sync-auth: #f8fbff;
    --soft-bg-select: #fafcff;

    /* Legacy aliases (used across components.qss / app.qss). */
    --bg-primary: #eef2f7;
    --bg-canvas: #f8fafd;
    --bg-elevated: #ffffff;
    --bg-sidebar: #f2f6fb;
    --bg-search: #f3f6fb;
    --bg-hover: #eaf0f8;
    --bg-muted: #edf1f7;
    --bg-secondary: #f2f6fb;
    --bg-tertiary: #edf1f7;

    /* ---- Text ---- */
    --ink: #182230;
    --ink-2: #29384a;
    --body: #3e4e62;
    --body-2: #4b5c70;
    --muted: #526276;
    --muted-2: #56677c;
    --muted-3: #556579;
    --muted-4: #53687e;
    --muted-5: #5a6a7e;
    --muted-6: #5c6d82;
    --muted-7: #5e7085;
    --muted-8: #5f6f82;
    --muted-9: #647488;
    --muted-10: #66778b;
    --muted-11: #677688;
    --muted-12: #68788c;
    --muted-13: #6a7a90;
    --muted-14: #4d637a;
    --muted-15: #3e5d7b;
    --hint: #6f7f92;
    --hint-2: #6f8094;
    --hint-3: #707f91;
    --hint-4: #708093;
    --hint-5: #728191;
    --hint-6: #6c7b90;
    --hint-7: #6d7c90;
    --hint-8: #6a7c92;
    --hint-9: #707f91;
    --hint-10: #5d6f84;
    --placeholder: #8392a5;
    --placeholder-2: #7e8c9e;
    --placeholder-3: #808fa1;
    --placeholder-4: #8492a3;
    --info-value: #2d4056;
    --detail-copy: #537292;
    --detail-copy-2: #648099;
    --external-icon: #5681bd;

    /* Legacy text aliases. */
    --text-primary: #182230;
    --text-secondary: #4b5c70;
    --text-tertiary: #6f7f92;
    --text-quaternary: #8392a5;
    --text-inverse: #ffffff;

    /* ---- Borders ---- */
    --border-shell: #d9e1eb;
    --border-section: #e4e9ef;
    --border-section-2: #e5eaf0;
    --border-section-3: #e6ebf1;
    --border-section-4: #e8edf3;
    --border-panel: #dce4ee;
    --border-panel-2: #dfe6ee;
    --border-panel-3: #e1e8f0;
    --border-panel-4: #e3e9f0;
    --border-sidebar: #e3e8ef;
    --border-sidebar-2: #e2e8f0;
    --border-nav-hover: #e1eaf7;
    --border-drawer-inner: #e5ebf1;
    --border-card: #edf0f4;
    --border-card-hover: #dce6f4;
    --border-card-selected: #79a9ff;
    --border-divider-hair: #e1e6ed;

    /* Legacy border aliases. */
    --border: #d9e1eb;
    --border-strong: #dce4ee;
    --border-soft: #e3e8ef;
    --border-tertiary: #edf0f4;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #276cf0;
    --accent-hover: #1d60df;
    --accent-pressed: #1955c8;
    --accent-soft: #e8f0ff;
    --accent-soft-hover: #d9e5ff;
    --accent-fg: #ffffff;
    --avatar-0-bg: #ebf3ff;
    --avatar-0-fg: #2577ce;
    --avatar-1-bg: #e9f7ef;
    --avatar-1-fg: #247a49;
    --avatar-2-bg: #fff3df;
    --avatar-2-fg: #9a5a00;
    --avatar-3-bg: #f3edff;
    --avatar-3-fg: #7051b5;
    --avatar-4-bg: #ffedf0;
    --avatar-4-fg: #ad3f55;
    --avatar-5-bg: #edf1f6;
    --avatar-5-fg: #4d5e70;

    /* ---- Semantic ---- */
    --success: #34a36a;
    --success-text: #2e9d5b;
    --success-tint: #e6f8ed;
    --success-soft: #e2f2ea;
    --warn: #d27d45;
    --warn-text: #9d643c;
    --warn-tint: #fff8f2;
    --warn-border: #f1d9c5;
    --warning: #d27d45;
    --danger-text: #bd5b57;
    --danger: #b7463e;
    --danger-hover: #a03830;
    --danger-soft: #fbe9e6;
    --toggle-off: #cbd5e1;

    --strength-weak: #b7463e;
    --strength-medium: #d27d45;
    --strength-strong: #34a36a;

    --toast-bg: #1e2a38;
    --toast-fg: #ffffff;

    --focus-ring: #8ab3ff;
    --shadow: rgba(52, 72, 99, 32);
    --dialog-shadow: #324969;
    --dialog-backdrop: rgba(49, 68, 93, 38);

    /* ---- Brand tiles (password-card icon square) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (design.md rounded scale) ---- */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 12px;
    --radius-2xl: 16px;
    --radius-shell: 22px;
    --radius-full: 9999px;
}
