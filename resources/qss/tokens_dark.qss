/* PassVault design tokens - dark theme. */
/* Notion desktop dark: warm charcoal surfaces (#191919 / #202020 / #252525), */
/* soft off-white ink, hairline #2f2f2f dividers, and the dark-mode Notion */
/* blue (#2383e2) as the single structural accent. Sticker colours stay */
/* decorative and only tint avatar tiles and status. */

* {
    /* ---- Brand / primary family ---- */
    --primary: #2383e2;
    --primary-pressed: #1b6fc2;
    --primary-tint: #1c2d3f;
    --primary-tint-2: #22384f;
    --primary-text-on-tint: #6cb2f2;
    --primary-accent-text: #6cb2f2;
    --primary-accent-alt: #6cb2f2;
    --primary-focus-border: #3d8fdc;
    --primary-hover-surface: #2a2a2a;
    --primary-hover-surface-2: #2a2a2a;
    --primary-hover-surface-3: #2c2c2c;
    --primary-hover-surface-4: #2a2a2a;
    --primary-hover-surface-5: #2a2a2a;
    --primary-hover-surface-6: #232323;
    --primary-tab-active-bg: #1c2d3f;
    --primary-strength-bar: #2383e2;
    --primary-strength-text: #6cb2f2;
    --primary-icon-cloud: #4b9ae6;
    --primary-icon-lock: #6cb2f2;
    --primary-setting-icon: #6cb2f2;
    --link: #5aa7ee;

    /* ---- Surfaces / backgrounds (warm charcoal tiers) ---- */
    --canvas: #191919;
    --shell: #202020;
    --detail-bg: #1e1e1e;
    --card: #202020;
    --card-selected: #1c2d3f;
    --card-hover: #262626;
    --soft-bg: #232323;
    --soft-bg-sync: #232323;
    --soft-bg-sync-auth: #232323;
    --soft-bg-select: #232323;
    --input-bg: #252525;

    /* Legacy aliases. */
    --bg-primary: #191919;
    --bg-canvas: #191919;
    --bg-elevated: #252525;
    --bg-sidebar: #202020;
    --bg-search: #252525;
    --bg-hover: #2c2c2c;
    --bg-muted: #2f2f2f;
    --bg-secondary: #202020;
    --bg-tertiary: #2f2f2f;

    /* ---- Text (warm off-white ramp) ---- */
    --ink: #ebebea;
    --ink-2: #d9d8d6;
    --body: #c4c3c0;
    --body-2: #b3b2af;
    --muted: #9b9a97;
    --muted-2: #9b9a97;
    --muted-3: #9b9a97;
    --muted-4: #9b9a97;
    --muted-5: #9b9a97;
    --muted-6: #9b9a97;
    --muted-7: #9b9a97;
    --muted-8: #8c8b88;
    --muted-9: #8c8b88;
    --muted-10: #8c8b88;
    --muted-11: #8c8b88;
    --muted-12: #8c8b88;
    --muted-13: #6f6e6b;
    --muted-14: #b3b2af;
    --muted-15: #c4c3c0;
    --hint: #858481;
    --hint-2: #858481;
    --hint-3: #858481;
    --hint-4: #858481;
    --hint-5: #858481;
    --hint-6: #858481;
    --hint-7: #858481;
    --hint-8: #7d7c79;
    --hint-9: #858481;
    --hint-10: #8c8b88;
    --placeholder: #5f5e5b;
    --placeholder-2: #5f5e5b;
    --placeholder-3: #5f5e5b;
    --placeholder-4: #5f5e5b;
    --info-value: #d9d8d6;
    --detail-copy: #9b9a97;
    --detail-copy-2: #858481;
    --external-icon: #6cb2f2;

    /* Legacy text aliases. */
    --text-primary: #ebebea;
    --text-secondary: #c4c3c0;
    --text-tertiary: #9b9a97;
    --text-quaternary: #6f6e6b;
    --text-inverse: #191919;

    /* ---- Borders (hairline charcoal dividers) ---- */
    --border-shell: #2f2f2f;
    --border-section: #2a2a2a;
    --border-section-2: #2a2a2a;
    --border-section-3: #2c2c2c;
    --border-section-4: #2c2c2c;
    --border-panel: #333333;
    --border-panel-2: #2f2f2f;
    --border-panel-3: #313131;
    --border-panel-4: #313131;
    --border-sidebar: #2a2a2a;
    --border-sidebar-2: #2c2c2c;
    --border-nav-hover: #343434;
    --border-drawer-inner: #2c2c2c;
    --border-card: #2a2a2a;
    --border-card-hover: #353535;
    --border-card-selected: #2a5a87;
    --border-divider-hair: #2c2c2c;
    --border-input: #3a3a3a;

    /* Legacy border aliases. */
    --border: #2f2f2f;
    --border-strong: #3d3d3d;
    --border-soft: #2a2a2a;
    --border-tertiary: #2a2a2a;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #2383e2;
    --accent-hover: #3a91e6;
    --accent-pressed: #1b6fc2;
    --accent-soft: #1c2d3f;
    --accent-soft-hover: #22384f;
    --accent-fg: #ffffff;

    /* Avatar tiles: sticker palette on charcoal (decoration only). */
    --avatar-0-bg: #1c2c3b;
    --avatar-0-fg: #7fbdf2;
    --avatar-1-bg: #1b2e20;
    --avatar-1-fg: #6dd085;
    --avatar-2-bg: #392617;
    --avatar-2-fg: #f29a55;
    --avatar-3-bg: #2c2338;
    --avatar-3-fg: #d6b6f6;
    --avatar-4-bg: #391f31;
    --avatar-4-fg: #ff8fd6;
    --avatar-5-bg: #182e2d;
    --avatar-5-fg: #5cc6c1;

    /* ---- Semantic ---- */
    --success: #2fb34d;
    --success-text: #5fd07a;
    --success-tint: #1b2e20;
    --success-soft: #1b2e20;
    --warn: #e9752a;
    --warn-text: #f0954a;
    --warn-tint: #33251a;
    --warn-border: #5a3d24;
    --warning: #e9752a;
    --danger-text: #f0706a;
    --danger: #e5534b;
    --danger-hover: #ec6a63;
    --danger-soft: #3a2121;
    --toggle-off: #474747;

    --strength-weak: #e5534b;
    --strength-medium: #e9752a;
    --strength-strong: #2fb34d;

    --toast-bg: #2f2f2f;
    --toast-fg: #ebebea;

    --focus-ring: #3d8fdc;
    --shadow: rgba(0, 0, 0, 140);
    --dialog-shadow: #000000;
    --dialog-backdrop: rgba(0, 0, 0, 130);

    /* ---- Brand tiles (brand-fixed, identical across themes) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (unified with light theme) ---- */
    --radius-xs: 4px;
    --radius-sm: 5px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 12px;
    --radius-2xl: 16px;
    --radius-shell: 16px;
    --radius-full: 9999px;
}
