/* PassVault design tokens - dark theme. */
/* cc-switch design language: neutral near-black structure (#1c1c1e canvas, */
/* #2e2e33 cards, zinc text ramp) with a single blue action color (#2383e2). */
/* Blue is reserved for primary buttons, switches, focus rings, links and */
/* action text and password card selection; navigation stays neutral gray. */

* {
    /* ---- Brand / primary family ---- */
    --primary: #2383e2;
    --primary-pressed: #1b6fc2;
    --primary-tint: #1c2d3f;
    --primary-tint-2: #22384f;
    --primary-text-on-tint: #6cb2f2;
    --primary-accent-text: #6cb2f2;
    --primary-accent-alt: #6cb2f2;
    --primary-focus-border: #3d8fdc;
    --primary-hover-surface: #26262a;
    --primary-hover-surface-2: #26262a;
    --primary-hover-surface-3: #26262a;
    --primary-hover-surface-4: #26262a;
    --primary-hover-surface-5: #26262a;
    --primary-hover-surface-6: #1f1f23;
    --primary-tab-active-bg: #313136;
    --primary-strength-bar: #2383e2;
    --primary-strength-text: #6cb2f2;
    --primary-icon-cloud: #ababb3;
    --primary-icon-lock: #ababb3;
    --primary-setting-icon: #ababb3;
    --link: #5aa7ee;

    /* ---- Surfaces / backgrounds (neutral near-black tiers) ---- */
    --canvas: #1c1c1e;
    --shell: #1c1c1e;
    --detail-bg: #1c1c1e;
    --card: #2e2e33;
    --card-selected: #313136;
    --card-hover: #26262a;
    --soft-bg: #26262a;
    --soft-bg-sync: #26262a;
    --soft-bg-sync-auth: #26262a;
    --soft-bg-select: #26262a;
    --input-bg: #2e2e33;

    /* Legacy aliases. */
    --bg-primary: #1c1c1e;
    --bg-canvas: #1c1c1e;
    --bg-elevated: #2e2e33;
    --bg-sidebar: #161618;
    --bg-search: #2e2e33;
    --bg-hover: #26262a;
    --bg-muted: #26262a;
    --bg-secondary: #26262a;
    --bg-tertiary: #313136;

    /* ---- Text (zinc ramp) ---- */
    --ink: #e4e4e7;
    --ink-2: #d4d4d8;
    --body: #ababb3;
    --body-2: #9a9aa2;
    --muted: #9a9aa2;
    --muted-2: #9a9aa2;
    --muted-3: #9a9aa2;
    --muted-4: #9a9aa2;
    --muted-5: #9a9aa2;
    --muted-6: #9a9aa2;
    --muted-7: #9a9aa2;
    --muted-8: #9a9aa2;
    --muted-9: #9a9aa2;
    --muted-10: #9a9aa2;
    --muted-11: #9a9aa2;
    --muted-12: #9a9aa2;
    --muted-13: #6f6f77;
    --muted-14: #ababb3;
    --muted-15: #e4e4e7;
    --hint: #9a9aa2;
    --hint-2: #9a9aa2;
    --hint-3: #9a9aa2;
    --hint-4: #9a9aa2;
    --hint-5: #9a9aa2;
    --hint-6: #9a9aa2;
    --hint-7: #9a9aa2;
    --hint-8: #6f6f77;
    --hint-9: #9a9aa2;
    --hint-10: #9a9aa2;
    --placeholder: #9a9aa2;
    --placeholder-2: #9a9aa2;
    --placeholder-3: #9a9aa2;
    --placeholder-4: #9a9aa2;
    --info-value: #e4e4e7;
    --detail-copy: #ababb3;
    --detail-copy-2: #9a9aa2;
    --external-icon: #6cb2f2;

    /* Legacy text aliases. */
    --text-primary: #e4e4e7;
    --text-secondary: #ababb3;
    --text-tertiary: #9a9aa2;
    --text-quaternary: #6f6f77;
    --text-inverse: #18181b;

    /* ---- Borders (neutral charcoal dividers) ---- */
    --border-shell: #3e3e45;
    --border-section: #2c2c31;
    --border-section-2: #2c2c31;
    --border-section-3: #2c2c31;
    --border-section-4: #2c2c31;
    --border-panel: #3e3e45;
    --border-panel-2: #3e3e45;
    --border-panel-3: #3e3e45;
    --border-panel-4: #3e3e45;
    --border-sidebar: #3e3e45;
    --border-sidebar-2: #3e3e45;
    --border-nav-hover: #4a4a52;
    --border-drawer-inner: #3e3e45;
    --border-card: #3e3e45;
    --border-card-hover: #4a4a52;
    --border-card-selected: #2383e2;
    --border-divider-hair: #2c2c31;
    --border-input: #4a4a52;

    /* Legacy border aliases. */
    --border: #3e3e45;
    --border-strong: #4a4a52;
    --border-soft: #2c2c31;
    --border-tertiary: #2c2c31;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #2383e2;
    --accent-hover: #3a91e6;
    --accent-pressed: #1b6fc2;
    --accent-soft: #1c2d3f;
    --accent-soft-hover: #22384f;
    --accent-fg: #ffffff;

    /* Avatar tiles: cc-switch mode/chart palette (decoration only). */
    --avatar-0-bg: #222a34;
    --avatar-0-fg: #8fb8e6;
    --avatar-1-bg: #212b2c;
    --avatar-1-fg: #7cc4ba;
    --avatar-2-bg: #292734;
    --avatar-2-fg: #b5a6e3;
    --avatar-3-bg: #16303c;
    --avatar-3-fg: #38bdf8;
    --avatar-4-bg: #3a1f2e;
    --avatar-4-fg: #f472b6;
    --avatar-5-bg: #1c2c3b;
    --avatar-5-fg: #7fbdf2;

    /* ---- Semantic ---- */
    --success: #4ade80;
    --success-text: #4ade80;
    --success-tint: #0f2b1a;
    --success-soft: #0f2b1a;
    --warn: #fbbf24;
    --warn-text: #fcd34d;
    --warn-tint: #33260a;
    --warn-border: #4a3a12;
    --warning: #fbbf24;
    --danger-text: #fca5a5;
    --danger: #f87171;
    --danger-hover: #fca5a5;
    --danger-soft: #3a1414;
    --switch-off-disabled-icon: :/icons/switch-off-disabled-dark.svg;
    --switch-on-disabled-icon: :/icons/switch-on-disabled-dark.svg;
    --toggle-off-disabled: #4b4b52;
    --toggle-on-disabled: #295482;
    --toggle-off: #6f6f77;

    --strength-weak: #f87171;
    --strength-medium: #fbbf24;
    --strength-strong: #4ade80;

    --toast-bg: #f4f4f5;
    --toast-fg: #18181b;

    --focus-ring: #3d8fdc;
    --shadow: rgba(0, 0, 0, 140);
    --dialog-shadow: #000000;
    --dialog-backdrop: rgba(0, 0, 0, 140);

    /* ---- Brand tiles (brand-fixed, identical across themes) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (unified with light theme) ---- */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 6px;
    --radius-lg: 10px;
    --radius-xl: 10px;
    --radius-2xl: 14px;
    --radius-shell: 14px;
    --radius-full: 9999px;
}
