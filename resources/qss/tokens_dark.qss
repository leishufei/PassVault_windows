/* PassVault design tokens - dark theme. */
/* Accent family (#276cf0) unified with light theme; surfaces use a 3-tier */
/* cool-slate dark hierarchy inspired by Linear / 1Password 8 so sidebars, */
/* list columns, detail surfaces, and cards separate naturally without harsh */
/* bright borders. */

* {
    /* ---- Brand / primary family (accent unified with light theme) ---- */
    --primary: #276cf0;
    --primary-pressed: #1d60df;
    --primary-tint: #192d50;
    --primary-tint-2: #203966;
    --primary-text-on-tint: #7ab0ff;
    --primary-accent-text: #7ab0ff;
    --primary-accent-alt: #7ab0ff;
    --primary-focus-border: #3b7bf6;
    --primary-hover-surface: #1d2432;
    --primary-hover-surface-2: #192b49;
    --primary-hover-surface-3: #192b49;
    --primary-hover-surface-4: #1d2432;
    --primary-hover-surface-5: #1d2432;
    --primary-hover-surface-6: #1a212e;
    --primary-tab-active-bg: #192d50;
    --primary-strength-bar: #3b7bf6;
    --primary-strength-text: #7ab0ff;
    --primary-icon-cloud: #5b95ff;
    --primary-icon-lock: #7ab0ff;
    --primary-setting-icon: #7ab0ff;
    --link: #7ab0ff;

    /* ---- Surfaces / backgrounds (3-tier cool slate) ---- */
    --canvas: #0b0e14;
    --shell: #151a23;
    --detail-bg: #181e28;
    --card: #1d2430;
    --card-selected: #1b2c49;
    --card-hover: #222a38;
    --soft-bg: #161c26;
    --soft-bg-sync: #161c26;
    --soft-bg-sync-auth: #171e29;
    --soft-bg-select: #161c26;

    /* Legacy aliases. */
    --bg-primary: #0b0e14;
    --bg-canvas: #151a23;
    --bg-elevated: #1d2430;
    --bg-sidebar: #11151d;
    --bg-search: #11161f;
    --bg-hover: #1e2533;
    --bg-muted: #181f2b;
    --bg-secondary: #11151d;
    --bg-tertiary: #181f2b;

    /* ---- Text (4 distinct contrast tiers) ---- */
    --ink: #f1f5f9;
    --ink-2: #dde5f0;
    --body: #b8c4d4;
    --body-2: #a5b3c6;
    --muted: #90a0b5;
    --muted-2: #93a3b8;
    --muted-3: #90a0b5;
    --muted-4: #8fa0b6;
    --muted-5: #8c9cb1;
    --muted-6: #8e9eb3;
    --muted-7: #91a1b6;
    --muted-8: #8d9db2;
    --muted-9: #92a2b7;
    --muted-10: #93a3b8;
    --muted-11: #94a4b9;
    --muted-12: #8fa0b5;
    --muted-13: #8d9eb4;
    --muted-14: #a8b6c8;
    --muted-15: #b8c5d6;
    --hint: #758499;
    --hint-2: #76859a;
    --hint-3: #758499;
    --hint-4: #76859a;
    --hint-5: #77869b;
    --hint-6: #748398;
    --hint-7: #758499;
    --hint-8: #78889e;
    --hint-9: #758499;
    --hint-10: #7e8ea4;
    --placeholder: #5c6a7e;
    --placeholder-2: #5e6c80;
    --placeholder-3: #5d6b7f;
    --placeholder-4: #606e82;
    --info-value: #d6e0ec;
    --detail-copy: #8fa0b5;
    --detail-copy-2: #8fa0b5;
    --external-icon: #7ab0ff;

    /* Legacy text aliases. */
    --text-primary: #f1f5f9;
    --text-secondary: #b8c4d4;
    --text-tertiary: #758499;
    --text-quaternary: #5c6a7e;
    --text-inverse: #0b0e14;

    /* ---- Borders (hairline slate dividers, no harsh bright boxes) ---- */
    --border-shell: #232b3a;
    --border-section: #232b3a;
    --border-section-2: #222a38;
    --border-section-3: #242c3b;
    --border-section-4: #242c3b;
    --border-panel: #2b3547;
    --border-panel-2: #262f40;
    --border-panel-3: #293345;
    --border-panel-4: #283244;
    --border-sidebar: #1e2532;
    --border-sidebar-2: #1f2634;
    --border-nav-hover: #213862;
    --border-drawer-inner: #242c3b;
    --border-card: #263041;
    --border-card-hover: #334158;
    --border-card-selected: #3b7bf6;
    --border-divider-hair: #242c3b;

    /* Legacy border aliases. */
    --border: #252e3e;
    --border-strong: #313d52;
    --border-soft: #1f2634;
    --border-tertiary: #263041;

    /* ---- Accent (mapped from primary for legacy references) ---- */
    --accent: #276cf0;
    --accent-hover: #3b7bf6;
    --accent-pressed: #1d60df;
    --accent-soft: #192d50;
    --accent-soft-hover: #213a67;
    --accent-fg: #ffffff;
    --avatar-0-bg: #182c4e;
    --avatar-0-fg: #7ab0ff;
    --avatar-1-bg: #143121;
    --avatar-1-fg: #67c58a;
    --avatar-2-bg: #332510;
    --avatar-2-fg: #f2b755;
    --avatar-3-bg: #292042;
    --avatar-3-fg: #b69be8;
    --avatar-4-bg: #381d26;
    --avatar-4-fg: #eb8fa1;
    --avatar-5-bg: #232a36;
    --avatar-5-fg: #b9c4d2;

    /* ---- Semantic ---- */
    --success: #34a36a;
    --success-text: #52c088;
    --success-tint: #143121;
    --success-soft: #143121;
    --warn: #f5a623;
    --warn-text: #eab044;
    --warn-tint: #2b200e;
    --warn-border: #4a3618;
    --warning: #f5a623;
    --danger-text: #f06468;
    --danger: #e5484d;
    --danger-hover: #ec5d61;
    --danger-soft: #361a20;
    --toggle-off: #313c4f;

    --strength-weak: #e5484d;
    --strength-medium: #f5a623;
    --strength-strong: #34a36a;

    --toast-bg: #1d2430;
    --toast-fg: #f1f5f9;

    --focus-ring: #3b7bf6;
    --shadow: rgba(0, 0, 0, 136);
    --dialog-shadow: #05070b;
    --dialog-backdrop: rgba(6, 9, 14, 128);

    /* ---- Brand tiles (brand-fixed, identical across themes) ---- */
    --brand-google-bg: #f7f8fa;
    --brand-google-fg: #4285f4;
    --brand-github-bg: #202725;
    --brand-github-fg: #ffffff;
    --brand-microsoft-bg: #ebf3ff;
    --brand-microsoft-fg: #2577ce;
    --brand-alipay-bg: #1677ff;
    --brand-alipay-fg: #ffffff;
    --brand-wechat-bg: #20b85a;
    --brand-wechat-fg: #ffffff;
    --brand-amazon-bg: #1e2930;
    --brand-amazon-fg: #f7ad2d;
    --brand-notion-bg: #ffffff;
    --brand-notion-fg: #171717;

    /* ---- Radii (unified with light theme) ---- */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 8px;
    --radius-lg: 10px;
    --radius-xl: 12px;
    --radius-2xl: 16px;
    --radius-shell: 22px;
    --radius-full: 9999px;
}
